# 仅 RAG 真实依赖测试的开关；业务配置仍由根 .env + config.settings 提供。
# 默认全部关闭，避免 `pytest tests` 意外触发真实入库/删除/LLM 成本。
# 运行时用命令行显式开启，例如：
#   RAG_REAL_INGEST=1 pytest tests/test_rag_real_build.py -m integration -s
#   RAG_REAL_RETRIEVAL=1 pytest tests/test_rag_real_retrieval.py -m integration -s
#   RAG_REAL_CLEANUP=1 pytest tests/test_rag_real_cleanup.py -m integration -s
#   RAG_REAL_AGENT=1 pytest tests/test_agent_rag_e2e.py -m integration -s
RAG_REAL_INGEST=0
RAG_REAL_RETRIEVAL=0
RAG_REAL_CLEANUP=0
RAG_REAL_IMAGE_PDF=1
