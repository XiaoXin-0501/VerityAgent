# 生产环境由 Nginx 等反向代理把 /api/v1 转发到 FastAPI
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=VerityAgent
VITE_TOKEN_STORAGE_KEY=verity-agent-token
VITE_THEME_STORAGE_KEY=verity-agent-theme
VITE_REQUEST_TIMEOUT_MS=15000
VITE_MESSAGE_PAGE_SIZE=50
VITE_MAX_MESSAGE_PAGES=20
VITE_SSE_RECONNECT_DELAY_MS=1000
VITE_SSE_MAX_RECONNECT_ATTEMPTS=5
VITE_SHOW_THINKING=true
VITE_CONVERSATION_TITLE_MAX_LENGTH=30
# 单条消息最大字符数（与后端 MessageConfig.max_text_chars 对齐）
VITE_MAX_MESSAGE_CHARS=200000
# 会话当前 run_id 的 sessionStorage 前缀（刷新后恢复流式状态）
VITE_RUN_STORAGE_PREFIX=verity-agent-run:
