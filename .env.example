# ==========================================================
# VerityAgent 环境变量模板
# 双下划线分隔层级：组名__字段名
# 所有默认值同时定义在 config/ 包中；这里只做部署覆盖。
# ==========================================================

# —— 应用 / 服务 ——
# 运行环境：dev / test / prod；prod 不自动建表/建 collection
APP__ENV=dev
# 应用名；用于 OpenAPI、日志、健康检查
APP__NAME=VerityAgent
# 应用版本；用于 OpenAPI 与健康检查
APP__VERSION=0.1.0
# 是否开启 FastAPI debug；生产必须 false
APP__DEBUG=false
# HTTP API 统一前缀
APP__API_PREFIX=/api/v1
# 日志级别：DEBUG / INFO / WARNING / ERROR
APP__LOG_LEVEL=INFO

# ASGI 监听地址；0.0.0.0 表示所有网卡
SERVER__HOST=0.0.0.0
# ASGI 监听端口
SERVER__PORT=8000
# 开发热重载；与 workers > 1 互斥
SERVER__RELOAD=false
# 生产 worker 进程数；Windows 建议 1
SERVER__WORKERS=1
# 反向代理挂载路径；如部署在 /verity 下
SERVER__ROOT_PATH=
# 允许跨域的前端源列表（JSON 数组）；空表示不启用 CORS
SERVER__CORS_ORIGINS=[]
# CORS 是否允许携带 Cookie/Authorization
SERVER__CORS_ALLOW_CREDENTIALS=true
# 请求体大小上限（字节）
SERVER__MAX_REQUEST_BODY_BYTES=26214400

# —— PostgreSQL ——
# PostgreSQL 主机名 / IP
PG__SERVER=localhost
# PostgreSQL 端口
PG__PORT=5432
# 登录用户名
PG__USER=agent
# 登录密码；生产必须通过环境变量/secret 注入
PG__PASSWORD=agent
# 数据库名
PG__DB=agent_db

# 连接池最少保持的空闲连接数
PG__POOL_MIN_SIZE=0
# 连接池最大连接数
PG__POOL_MAX_SIZE=10
# 从连接池取连接的最长等待时间（秒）
PG__POOL_TIMEOUT=10
# 单次建立 TCP 连接的超时时间（秒）
PG__CONNECT_TIMEOUT=10
# 空闲连接最长保留时间（秒）；0 表示不限制
PG__POOL_MAX_IDLE=600
# 单条连接最长存活时间（秒）；0 表示不限制
PG__POOL_MAX_LIFETIME=3600

# —— Redis ——
# Redis URL；支持 redis://、rediss://、unix://，兼容 host:port/db 简写
REDIS__URL=redis://localhost:6379/0
# Redis 6+ ACL 用户名；也可直接写在 REDIS__URL 里
REDIS__USERNAME=
# Redis 密码；也可直接写在 REDIS__URL 里
REDIS__PASSWORD=
# 客户端连接池最大连接数
REDIS__MAX_CONNECTIONS=20
# 单条命令读写超时（秒）
REDIS__SOCKET_TIMEOUT=5
# 建立连接超时（秒）
REDIS__SOCKET_CONNECT_TIMEOUT=5
# 连接健康检查间隔（秒）；0 表示关闭
REDIS__HEALTH_CHECK_INTERVAL=30
# 是否把命令结果解码为 str；缓存 JSON 时保持 true
REDIS__DECODE_RESPONSES=true

# —— 认证 ——
# JWT 签名密钥；生产必须改成随机长字符串
AUTH__SECRET_KEY=please-change-me
# JWT 算法；只支持 HS256 / HS384 / HS512
AUTH__ALGORITHM=HS256
# access token 有效期（分钟）；默认 7 天
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 可选 issuer；配置后签发与校验都会带 iss
# AUTH__ISSUER=verity-agent
# 可选 audience；配置后签发与校验都会带 aud
# AUTH__AUDIENCE=verity-web

# —— MinIO（占位：填好真实信息后把 ENABLED 改为 true）——
# 是否启用 MinIO 功能
MINIO__ENABLED=false
# MinIO API 地址，格式 host:port，不带 scheme
MINIO__ENDPOINT=localhost:9000
# Access Key；建议通过 env 注入
MINIO__ACCESS_KEY=minioadmin
# Secret Key；生产必须通过 env/secret 注入
MINIO__SECRET_KEY=minioadmin
# 是否使用 HTTPS
MINIO__SECURE=false
# 区域；不填使用服务端默认区域
# MINIO__REGION=us-east-1
# 是否校验 TLS 证书；仅内网自签名证书时才建议关闭
MINIO__CERT_CHECK=true
# 建立连接超时（秒）
MINIO__CONNECT_TIMEOUT_S=10
# 读取响应超时（秒）；大文件可调大
MINIO__READ_TIMEOUT_S=60
# 传输层最大重试次数
MINIO__MAX_RETRIES=3
# 分片上传的分片大小（字节）；默认 8 MiB
MINIO__PART_SIZE=8388608
# 预签名 URL 有效期（秒）；仅用于响应期临时跳转
MINIO__PRESIGN_EXPIRY_S=300
# dev/test 是否自动创建缺失 bucket；生产建议 false
MINIO__AUTO_CREATE_BUCKETS=true
# 启动连接失败是否阻断应用
MINIO__REQUIRED_FOR_STARTUP=false
# 知识库长期对象 bucket 名
MINIO__BUCKETS__KB=agent-kb
# 会话临时对象 bucket 名
MINIO__BUCKETS__SESSION=agent-session

# —— Weaviate（D-97：prod 只校验，不自动建 collection）——
# 是否启用 Weaviate
WEAVIATE__ENABLED=false
# HTTP 地址；支持 http:// / https://
WEAVIATE__URL=http://localhost:8080
# gRPC 主机；不填使用 HTTP URL 的 host
# WEAVIATE__GRPC_HOST=localhost
# gRPC 端口；Weaviate 4.x 默认 50051
WEAVIATE__GRPC_PORT=50051
# gRPC 是否使用 TLS
WEAVIATE__GRPC_SECURE=false
# API Key；Weaviate Cloud/启用认证时必填
# WEAVIATE__API_KEY=
# 普通查询/写入请求超时（秒）
WEAVIATE__TIMEOUT_S=30
# 建立连接/初始化超时（秒）
WEAVIATE__STARTUP_TIMEOUT_S=10
# 是否跳过连通性初始化检查；排障时可临时打开
WEAVIATE__SKIP_INIT_CHECKS=false
# dev/test 是否自动创建缺失 collection；prod 必须 false
WEAVIATE__AUTO_CREATE_COLLECTIONS=false
# 期望 schema 版本；与 manifest/schema_import.json 对齐
WEAVIATE__EXPECTED_SCHEMA_VERSION=2026-11-09
# 手写 schema import JSON 路径
WEAVIATE__SCHEMA_IMPORT_PATH=doc/weaviate_schema_import.json
# 启动时是否执行 schema 校验
WEAVIATE__STARTUP_SCHEMA_CHECK=true
# DocChunk collection 名
WEAVIATE__DOC_CHUNK_COLLECTION=DocChunk
# UserFact collection 名
WEAVIATE__USER_FACT_COLLECTION=UserFact
# 启动连接失败是否阻断应用
WEAVIATE__REQUIRED_FOR_STARTUP=false

# —— Neo4j（v1 入库建图；检索扩展默认关闭）——
# 是否启用 Neo4j
NEO4J__ENABLED=false
# Bolt/Neo4j URI，如 bolt://localhost:7687 或 neo4j://host:7687
NEO4J__URI=bolt://localhost:7687
# 登录用户名
NEO4J__USER=neo4j
# 登录密码；生产必须通过 env/secret 注入
NEO4J__PASSWORD=please-change-me
# 目标数据库名（Neo4j 4+ 多库）
NEO4J__DATABASE=neo4j
# 驱动连接池最大连接数
NEO4J__MAX_CONNECTION_POOL_SIZE=50
# 建立连接超时（秒）
NEO4J__CONNECTION_TIMEOUT_S=10
# 事务级最大重试时间（秒）
NEO4J__MAX_TRANSACTION_RETRY_TIME_S=30
# 连接池中单条连接最长存活时间（秒）
NEO4J__MAX_CONNECTION_LIFETIME_S=3600
# 启动时是否创建唯一约束/索引
NEO4J__INIT_SCHEMA_ON_STARTUP=true
# 启动连接失败是否阻断应用
NEO4J__REQUIRED_FOR_STARTUP=false

# —— 消息 ——
# content 协议写入版本；读取兼容 v1
MESSAGE__CONTENT_VERSION=2
# 单条用户消息最多图片数
MESSAGE__MAX_IMAGES=9
# 单条用户消息最多文件数
MESSAGE__MAX_FILES=9
# 单张图片大小上限（字节）
MESSAGE__MAX_IMAGE_BYTES=20971520
# 单个文件大小上限（字节）
MESSAGE__MAX_FILE_BYTES=20971520
# 单条消息文本最大字符数
MESSAGE__MAX_TEXT_CHARS=200000
# 单条工具结果回喂 LLM 的字符上限；超出走 overflow 文件
MESSAGE__MAX_TOOL_RESULT_CHARS=60000

# —— LLM ——
# 默认应用模型 id（ModelRegistry），不是厂商模型名
# LLM__DEFAULT_MODEL_ID=chat-main
# 默认 fallback 应用模型 id 列表（JSON 数组）
# LLM__FALLBACK_MODEL_IDS=["chat-backup"]
# 是否启用模型级 fallback
LLM__ENABLE_MODEL_FALLBACK=true
# 非流式请求总超时（秒）
LLM__REQUEST_TIMEOUT_S=120
# 流式首 token 超时（秒）
LLM__STREAM_FIRST_TOKEN_TIMEOUT_S=60
# 流式总时长上限（秒）
LLM__STREAM_TOTAL_TIMEOUT_S=600
# 流式事件最大空闲（秒）
LLM__STREAM_IDLE_TIMEOUT_S=60
# 单次响应最多工具调用数
LLM__MAX_TOOL_CALLS_PER_RESPONSE=16

# —— Prompt 管理 ——
# 注意：配置组名是 PROMPTS（不是 PROMPT）；PROMPT 常被 shell 自身占用。
# 外部 Prompt 覆盖目录（必须含 manifest.json）；为空只用内置 prompt/templates
# PROMPTS__DIRECTORY=prompts-override
# 是否同时加载内置模板；false 时 directory 必须提供全部所需 prompt
PROMPTS__INCLUDE_BUILTIN=true
# 缺少必填 Prompt 变量时是否 fail-fast；生产建议 true
PROMPTS__STRICT=true

# —— Agent ——
# 单次 run 最多回合数
AGENT__POLICY__MAX_TURNS_PER_RUN=20
# 单回合最多工具轮数
AGENT__POLICY__MAX_TOOL_ROUNDS=8
# 单批最多并行工具数
AGENT__POLICY__MAX_PARALLEL_TOOLS=4
# 单次 run 最多 LLM 调用次数
AGENT__POLICY__MAX_LLM_CALLS_PER_RUN=20
# 会话 run 租约时长（秒）
AGENT__POLICY__RUN_LEASE_SECONDS=120
# run 续租间隔（秒）；应小于租约时长
AGENT__POLICY__RUN_HEARTBEAT_INTERVAL_S=30
# 单回合总超时（秒）
AGENT__POLICY__TURN_TIMEOUT_S=900
# SSE 心跳间隔（秒）
AGENT__STREAM__HEARTBEAT_INTERVAL_S=15
# 单连接待发送事件缓冲上限
AGENT__STREAM__MAX_BUFFER_EVENTS=512
# 断线重放缓冲事件数
AGENT__STREAM__REPLAY_BUFFER_SIZE=1024
# 运行期状态落 Redis 的 TTL（秒）
AGENT__RUN_STATE_TTL_S=3600
# 取消 run 的收尾宽限时间（秒）
AGENT__CANCEL_GRACE_S=5

# —— 工具 ——
# 工具选择模式：none / single_level / multi_level
TOOLS__ROUTING__MODE=none
# 可用工具数低于该值直接全量暴露
TOOLS__ROUTING__FLAT_THRESHOLD=15
# 单次暴露给 LLM 的工具上限
TOOLS__ROUTING__MAX_EXPOSED_TOOLS=30
# 一级路由组上限
TOOLS__ROUTING__MAX_GROUPS=8
# 路由工具名前缀
TOOLS__ROUTING__ROUTER_PREFIX=router_
# 单批工具并行上限
TOOLS__MAX_BATCH_CONCURRENCY=4
# 单个工具入参 JSON 字节上限
TOOLS__MAX_ARGUMENT_BYTES=65536
# 危险工具确认开关；v1 只预留模型，不实现暂停/恢复流程
TOOLS__APPROVAL_ENABLED=false

# —— RAG ——
# 启用文档类型（JSON 数组）；v1 支持 pdf/docx/markdown/text/spreadsheet
RAG__INDEXER__ENABLED_DOC_TYPES=["pdf","docx","markdown","text","spreadsheet"]
# 入库 embedding 应用模型 id（必须对应 ProviderModelSpec.id）
# 若 Provider 只配 default_model=bge-m3，则这里填 bge-m3；
# 若 METADATA.models[].id=embed-default，则这里填 embed-default
RAG__INDEXER__EMBEDDING_MODEL_ID=embed-default
# 向量维度；必须与 Weaviate collection 对齐
RAG__INDEXER__EMBEDDING_DIMENSIONS=1024
# embedding 版本；换模型/维度时递增
RAG__INDEXER__EMBEDDING_VERSION=v1
# 目标 chunk token 大小
RAG__INDEXER__CHUNK_SIZE_TOKENS=512
# 相邻 chunk 重叠 token
RAG__INDEXER__CHUNK_OVERLAP_TOKENS=64
# 切片策略版本
RAG__INDEXER__CHUNKING_VERSION=v1
# 低于该字符数的块丢弃
RAG__INDEXER__MIN_CHUNK_CHARS=30
# 超过该字符数的块截断/拆分
RAG__INDEXER__MAX_CHUNK_CHARS=8000
# 是否启用入库降噪质量闸门
RAG__INDEXER__QUALITY_GATE_ENABLED=true
# v1 入库是否建图；检索扩展由 RETRIEVER__GRAPH_EXPANSION_ENABLED 控制
RAG__INDEXER__GRAPH_BUILD_ENABLED=true
# 索引策略文件（质量扣分/词表/阶段进度）；为空使用 config/rag_policy.json
# 相对路径按 verity-agent 解析
# RAG__INDEXER__INDEXER_POLICY_PATH=config/rag_policy.json
# 入库任务最大重试次数
RAG__INDEXER__INDEX_MAX_ATTEMPTS=5
# 入库 worker 租约时长（秒）
RAG__INDEXER__INDEX_LEASE_SECONDS=300
# 入库失败退避基数（秒）
RAG__INDEXER__INDEX_RETRY_BACKOFF_S=30
# 混合召回候选数
RAG__RETRIEVER__TOP_K=20
# rerank 后保留数
RAG__RETRIEVER__RERANK_TOP_K=8
# 混合检索向量/BM25 权重（0=纯 BM25，1=纯向量）
RAG__RETRIEVER__HYBRID_ALPHA=0.5
# 低于该分数的 chunk 丢弃
RAG__RETRIEVER__MIN_SCORE=0
# 是否启用 rerank
RAG__RETRIEVER__RERANK_ENABLED=true
# rerank 应用模型 id（引用 MODELS[].id；未配置 rerank 模型时留空）
# # RAG__RETRIEVER__RERANK_MODEL_ID=rerank-default
# 是否启用 query 改写
RAG__RETRIEVER__QUERY_REWRITE_ENABLED=false
# query 改写最多变体数
RAG__RETRIEVER__QUERY_REWRITE_MAX_VARIANTS=2
# query 改写应用模型 id；为空使用 LLM 默认模型
# RAG__RETRIEVER__QUERY_REWRITE_MODEL_ID=
# 是否启用图检索扩展
RAG__RETRIEVER__GRAPH_EXPANSION_ENABLED=false
# 图扩展最大跳数；v1 只允许 1
RAG__RETRIEVER__GRAPH_MAX_HOPS=1
# 检索结果缓存 TTL（秒）；0 表示不缓存
RAG__RETRIEVER__CACHE_TTL_S=300
# 文档描述有效最小字符数
RAG__DESCRIPTION_MIN_CHARS=40
# 文档描述最大字符数
RAG__DESCRIPTION_MAX_CHARS=500
# 单条 query 最大字符数
RAG__MAX_QUERY_CHARS=2000

# Indexer 其他参数
# 默认解析/切片 profile
RAG__INDEXER__DEFAULT_PROFILE=default
# 默认切片 profile
RAG__INDEXER__CHUNKING_PROFILE=default
# embedding 批大小
RAG__INDEXER__EMBEDDING_BATCH_SIZE=32
# 文档描述生成模型 id
RAG__INDEXER__DESCRIPTION_MODEL_ID=
# 表格/Excel 语义描述模型 id
RAG__INDEXER__TABLE_SUMMARY_MODEL_ID=
# 代码语义描述模型 id
RAG__INDEXER__CODE_SUMMARY_MODEL_ID=
# 图抽取模型 id
RAG__INDEXER__GRAPH_MODEL_ID=
# 是否启用表格/Excel LLM 描述兜底
RAG__INDEXER__TABLE_SUMMARY_LLM_ENABLED=false
# 是否启用代码 LLM 描述兜底
RAG__INDEXER__CODE_SUMMARY_ENABLED=false
# 表格/代码是否只向量化 heading + 描述（正文仍落库供 BM25）
RAG__INDEXER__SEMANTIC_EMBEDDING_ENABLED=true
# heading 少于该 token 数才触发 LLM 兜底
RAG__INDEXER__SEMANTIC_HEADING_MIN_TOKENS=4
# 表格/Excel 送入 LLM 的预览行数
RAG__INDEXER__SEMANTIC_PREVIEW_ROWS=3
# 生成描述最大字符数
RAG__INDEXER__SEMANTIC_DESCRIPTION_MAX_CHARS=200
# 代码送入 LLM 的最大字符数
RAG__INDEXER__SEMANTIC_CODE_MAX_INPUT_CHARS=2000
# 是否生成文档描述
RAG__INDEXER__DESCRIPTION_ENABLED=true
# 目标 chunk token
RAG__INDEXER__CHUNK_SIZE_TOKENS=512
# chunk 最大 token
RAG__INDEXER__MAX_CHUNK_TOKENS=800
# chunk 最小 token
RAG__INDEXER__MIN_CHUNK_TOKENS=40
# 是否启用质量闸门
RAG__INDEXER__QUALITY_GATE_ENABLED=true
# 单 worker 并发文档数
RAG__INDEXER__MAX_CONCURRENCY=2
# chunk_id 命名空间
RAG__INDEXER__CHUNK_ID_NAMESPACE=verity:chunk
# 质量闸门：最小 chunk token
RAG__INDEXER__QUALITY__MIN_CHUNK_TOKENS=40
# 质量闸门：最大 chunk token
RAG__INDEXER__QUALITY__MAX_CHUNK_TOKENS=1200
# 质量闸门：低质量 chunk 是否丢弃
RAG__INDEXER__QUALITY__DROP_LOW_QUALITY_CHUNKS=false
# 是否按 content hash 去重 chunk
RAG__INDEXER__DEDUP__CHUNK_HASH=true

# Retriever 其他参数
# 最低质量分
# RAG__RETRIEVER__MIN_QUALITY_SCORE=0.3
# 上下文 token 预算；不填不限制
# RAG__RETRIEVER__TOKEN_BUDGET=6000
# rerank 候选数
RAG__RETRIEVER__RERANK_TOP_N=20
# rerank 批大小
RAG__RETRIEVER__RERANK_BATCH_SIZE=16
# rerank 最低分
# RAG__RETRIEVER__RERANK_MIN_SCORE=0.2
# query 改写超时（秒）
# RAG__RETRIEVER__QUERY_REWRITE_TIMEOUT_S=20
# query 改写最短 query token
# RAG__RETRIEVER__QUERY_REWRITE_MIN_QUERY_TOKENS=3
# 图关系白名单
RAG__RETRIEVER__GRAPH_ALLOWED_RELATIONS=["is_a","part_of","depends_on","implements","supports","requires","causes","contrasts"]
# 图关系最小证据数
RAG__RETRIEVER__GRAPH_MIN_EVIDENCE=2
# 最大下一跳实体数
RAG__RETRIEVER__GRAPH_MAX_NEXT_HOPS=5
# hub 是否可作为中间跳
RAG__RETRIEVER__GRAPH_HUB_AS_INTERMEDIATE=false
# 是否启用邻居扩展
RAG__RETRIEVER__NEIGHBORS_ENABLED=true
# 命中 chunk 前取几个邻居
RAG__RETRIEVER__NEIGHBOR_BEFORE=1
# 命中 chunk 后取几个邻居
RAG__RETRIEVER__NEIGHBOR_AFTER=1
# 邻居 token 预算
RAG__RETRIEVER__NEIGHBOR_MAX_TOKENS=1000
# 邻居是否限定同文档
RAG__RETRIEVER__NEIGHBOR_SAME_DOC=true
# 邻居是否限定同 block_type
RAG__RETRIEVER__NEIGHBOR_SAME_BLOCK_TYPE=true
# 文档状态缓存 TTL（秒）
RAG__RETRIEVER__DOC_STATUS_CACHE_TTL_S=60
# 文档 meta 缓存 TTL（秒）
RAG__RETRIEVER__DOC_META_CACHE_TTL_S=300

# —— Hooks ——
# 是否启用 Hooks
HOOKS__ENABLED=true
# 观察者失败不阻塞主流程
HOOKS__FAIL_OPEN=true
# 单个观察者派发超时（秒）
HOOKS__DISPATCH_TIMEOUT_S=1
# 异步派发队列上限
HOOKS__MAX_QUEUE_SIZE=10000
# 队列满时是否丢弃事件
HOOKS__DROP_ON_OVERFLOW=true
# 是否启用 LoggingHook
HOOKS__LOGGING__ENABLED=true
# 日志级别
HOOKS__LOGGING__LEVEL=INFO
# 是否附带 payload 摘要
HOOKS__LOGGING__INCLUDE_PAYLOAD=false
# payload 摘要最大字节数
HOOKS__LOGGING__MAX_PAYLOAD_BYTES=2048
# 订阅事件；空表示内置关键事件
HOOKS__LOGGING__EVENTS=[]
# 执行模式：background / inline
HOOKS__LOGGING__MODE=background

# 是否启用 TokenUsageHook
HOOKS__TOKEN_USAGE__ENABLED=true
# 是否写 Redis 实时计数
HOOKS__TOKEN_USAGE__REDIS_COUNTERS=true
# Redis 计数 scope
HOOKS__TOKEN_USAGE__COUNTER_SCOPES=["conversation","user_day"]
# seen:call_id 去重 TTL（秒）
HOOKS__TOKEN_USAGE__DEDUPE_TTL_S=86400
# 回合结束是否更新 conversations.total_*
HOOKS__TOKEN_USAGE__UPDATE_CONVERSATION_TOTALS=true

# 是否启用 MetricsHook
HOOKS__METRICS__ENABLED=true
# 指标 sink：log / noop
HOOKS__METRICS__SINK=log
# 指标采样率
HOOKS__METRICS__SAMPLE_RATE=1.0
# 指标名前缀
HOOKS__METRICS__PREFIX=verity

# 是否启用 TracingHook
HOOKS__TRACING__ENABLED=false
# exporter：none / log
HOOKS__TRACING__EXPORTER=none
# 追踪采样率
HOOKS__TRACING__SAMPLE_RATE=1.0

# 是否启用 AuditHook
HOOKS__AUDIT__ENABLED=true
# sink：log
HOOKS__AUDIT__SINK=log
# 是否附带脱敏 details
HOOKS__AUDIT__INCLUDE_DETAILS=false
# 订阅事件；空表示内置审计事件
HOOKS__AUDIT__EVENTS=[]

# 脱敏字段（逗号分隔）
HOOKS__REDACTION__ENABLED=true
# 按字段名脱敏
HOOKS__REDACTION__FIELDS=["password","token","secret","api_key","authorization","phone","email","id_card"]
# 文本正则脱敏
HOOKS__REDACTION__PATTERNS=[]
# 替换文本
HOOKS__REDACTION__REPLACEMENT=***
# 单段文本最大长度
HOOKS__REDACTION__MAX_TEXT_LENGTH=2048

# ==========================================================
# 模型配置（config/models.json）
#
# 顶层结构：{"models": [ {...}, {...} ]}
#
# 每个模型条目可配置字段：
#   id            应用模型 id，全局唯一；LLM/RAG 配置引用它
#   provider      适配器类型：
#                   chat      -> openai / anthropic
#                   embedding -> openai / bge
#                   rerank    -> cohere / bge
#   model         厂商实际模型名
#   kind          chat / embedding / rerank（默认 chat）
#   api_style     chat wire 协议：
#                   openai_chat / openai_responses / anthropic_messages
#   base_url      API 基地址；每个模型可不同
#   api_key_env   密钥环境变量名（推荐）
#   api_key       直接密钥（可选，优先于 api_key_env）
#   timeout_s     单次请求超时（秒）
#   max_retries   transport 重试次数
#   headers       额外非敏感 HTTP header（JSON 对象）
#   enabled       是否启用该模型
#   capabilities  能力（按 kind 填，见下）
#   pricing       价格（见下）
#   defaults      chat 默认生成参数（见下）
#   metadata      扩展字段（见下）
#
# capabilities 字段：
#   chat:
#     streaming / tool_calling / parallel_tool_calls / vision / file_input
#     thinking / prefix_completion / json_object / json_schema / prompt_caching
#     max_context_tokens / max_output_tokens / max_tools / max_images
#     input_modalities / output_modalities / tokenizer
#   embedding:
#     dimensions / max_batch_size / max_input_tokens
#     supports_dimensions / supports_normalize / input_type
#   rerank:
#     max_documents / max_query_tokens / max_document_tokens
#     max_batch_size / supports_return_documents
#
# pricing 字段：
#   input_per_million / output_per_million / cached_input_per_million
#   per_request / per_document / currency / effective_from
#
# defaults 字段（chat）：
#   temperature / top_p / max_output_tokens / stop / seed
#   presence_penalty / frequency_penalty / thinking_budget
#   parallel_tool_calls / provider_options
#
# metadata 常用字段：
#   variant（deepseek/vllm 等）、send_input_type、send_normalize、
#   documents_format（text/object）
# ==========================================================
# 推荐：模型目录放在 config/models.json；修改模型优先改这个文件。
# 所有配置项（含 embedding/rerank 价格）的可注释完整示例：
# config/models.example.jsonc
MODELS_FILE=config/models.json
# 可选：不使用文件时，直接把 JSON 数组写在 MODELS（文件存在时以文件为准）
# 不使用文件时，可改为 MODELS=[{...}] 内联 JSON

# —— 密钥变量（被 MODELS[].api_key_env 引用）——
# 如果 MODELS 里用的是 api_key_env，这里配置实际值；
# 如果 MODELS 里直接写了 api_key，则这里不需要再配。
# OpenAI 密钥（供 provider=openai 的模型使用）
# OPENAI_API_KEY=sk-...
# Anthropic 密钥（供 provider=anthropic 的模型使用）
# ANTHROPIC_API_KEY=sk-ant-...
# 其他 OpenAI-compatible 服务示例（如 Qwen embedding）
# QWEN_API_KEY=

# —— LLM 使用哪些模型 ——
# LLM 可用的应用模型 id 列表
# LLM__MODEL_IDS=["chat-main","chat-fast","chat-claude"]
# 默认模型 id
# LLM__DEFAULT_MODEL_ID=chat-main
# fallback 模型 id 列表
# LLM__FALLBACK_MODEL_IDS=["chat-fast","chat-claude"]
